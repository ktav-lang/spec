# Normalize text line endings to LF in the repository, regardless of
# contributor's platform or `core.autocrlf` setting. Working-tree files
# on all platforms check out with LF — no more CRLF/LF noise in
# `git status` from Windows clients.
* text=auto eol=lf

# Exception: conformance fixtures that intentionally test a specific
# line-ending behaviour (§ 3.2 of spec.md) must land on disk byte-for-byte
# as authored. The convention is a `crlf_` substring in the filename or
# explicit listing below; add more overrides here if other
# line-ending-sensitive fixtures are introduced.
versions/*/tests/valid/whitespace/crlf_*.ktav -text
versions/*/tests/valid/multiline/crlf_*.ktav -text
versions/*/tests/valid/multiline/crlf_*.canonical.ktav -text
versions/*/tests/valid/io/mixed_lf_crlf.ktav -text
versions/*/tests/valid/io/lone_cr_in_value.ktav -text
versions/*/tests/valid/io/lone_cr_in_value.canonical.ktav -text
versions/*/tests/valid/inline/escape/all_escapes.canonical.ktav -text
versions/*/tests/valid/inline/escape/newline.canonical.ktav -text

# Exception: this invalid fixture's exact CRLF bytes (an explicit root Array
# opened with `[` + CRLF and never closed) are the test condition; `-text`
# keeps git from normalizing the CR away at check-in.
versions/*/tests/invalid/unclosed/explicit_root_array_crlf.ktav -text

# Exception: this fixture intentionally contains a content line consisting
# of a single space character (a whitespace-only line inside a verbatim
# multi-line string, preserved byte-for-byte as regression coverage). A
# plain `git diff --check` treats that as "trailing whitespace"; suppress
# only that specific check for these two files so the pre-release
# whitespace gate doesn't permanently red-flag correct fixture content.
versions/*/tests/valid/multiline/verbatim_whitespace_only_line_in_middle.ktav whitespace=-trailing-space
versions/*/tests/valid/multiline/verbatim_whitespace_only_line_in_middle.canonical.ktav whitespace=-trailing-space

# Exception: every fixture under invalid/invalid_utf8/ is deliberately not
# valid UTF-8 (Sec 3.1, Sec 6.15) and its exact bytes are the test
# condition; two of them contain CR bytes that `* text=auto` would
# normalize away at check-in. `-text` keeps git from ever rewriting them.
versions/*/tests/invalid/invalid_utf8/*.ktav -text
